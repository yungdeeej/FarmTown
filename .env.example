# Copy to .env (or export in your shell) before running the scripts.
# The bot must already be in the guild with the Administrator permission.
DISCORD_BOT_TOKEN=
GUILD_ID=

# Optional branding assets (public image URLs).
# Drop the image in any Discord channel and "Copy Link".
LOGO_URL=
BANNER_URL=

# engagement-bot.js options.
# Set to 1 to enable auto-role + welcome on join (needs the privileged
# "Server Members Intent" enabled in the Developer Portal).
WELCOME_AUTOROLE=
# FARMER_ROLE=Farmer
# WELCOME_CHANNEL=💬・general
