# Copy to .env (or export in your shell) before running the scripts.
# The bot must already be in the guild with the Administrator permission.
DISCORD_BOT_TOKEN=
GUILD_ID=

# Optional branding assets (public image URLs).
# Drop the image in any Discord channel and "Copy Link".
LOGO_URL=
BANNER_URL=

# engagement-bot.js options.
# Set to 1 to enable auto-role + welcome on join (needs the privileged
# "Server Members Intent" enabled in the Developer Portal).
WELCOME_AUTOROLE=
# FARMER_ROLE=Farmer
# WELCOME_CHANNEL=💬・general

# Auto-responder for P2E / token / features / roadmap questions.
# Set to 1 to enable (needs the privileged "Message Content Intent").
AUTORESPONDER=
# AUTO_REPLY_CHANNELS=💬・general,📊・token-chat,🌾・farm-chat
# AUTO_REPLY_WINDOW=15

# Impersonation guard: on join / name-change, flag members posing as staff.
# High-confidence matches are timed out 7d; all are reported to #mod-log.
# Needs the "Server Members Intent".
IMPERSONATION_GUARD=
# MODLOG_CHANNEL=mod-log
# IMPERSONATION_HIGH=official,farmtown,support team,diddy,sully
# IMPERSONATION_MED=support,admin,moderator,developer,staff,team
